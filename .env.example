# Global
NODE_ENV=development

# Backend
DATABASE_URL=mongodb://mongo:mongo@localhost:27017/mini_erm?authSource=admin
PORT=4000

# Flask Parser Service (Enhanced Python parser)
FLASK_PARSER_URL=http://localhost:5100
FLASK_PARSER_TIMEOUT=30000
FLASK_PARSER_ENABLED=true

# Watcher
WATCH_FOLDERS=C:/Users/Y055R1/Desktop/Acrobate Solution;C:/Users/Y055R1/Desktop/GameStream ATLAS
BACKEND_INGEST_URL=http://localhost:4000/api/files/ingest
INGEST_API_KEY=change-me

# Backward compatibility (single folder mode):
# WATCH_FOLDER=C:/Users/Y055R1/Desktop/IncomingInvoices

# ── F1 flag worker (scheduler) ──
FLAG_WORKER_CRON=0 * * * *
FLAG_WORKER_RUN_ON_START=true

# ── F2 notification engine ──
# Master safety flag. Defaults to true (never sends real messages). Set to
# 'false' ONLY once credentials below are populated and tested against sandbox
# / test recipients you control.
NOTIFICATIONS_DRY_RUN=true

# Twilio SMS (required only when NOTIFICATIONS_DRY_RUN=false)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Gmail SMTP for email (App Password, NOT the raw account password)
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# ── F2 WhatsApp via Chatwoot (not implemented yet) ──
CHATWOOT_BASE_URL=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
