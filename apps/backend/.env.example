DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-host>/mini_erm
PORT=4000
INGEST_API_KEY=change-me

# Flask Parser Service (Enhanced Python parser)
FLASK_PARSER_URL=http://localhost:5100
FLASK_PARSER_TIMEOUT=30000
FLASK_PARSER_ENABLED=true

# Optional AI-assisted extraction fallback
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-4.1-mini

# Queue processing throughput
INGEST_CONCURRENCY=4
